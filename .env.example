# Copy this file to .env.local and fill in real values.
# The voice tutor needs Supabase (the factsheet RAG store) and an OpenAI key
# (used for embeddings, transcription, and TTS until those move to local
# services in the self-hosting plan).

# Supabase (server-side, service role). Get these from
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (browser-side, anon key). Used by middleware.ts and client pages.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI. Used by /api/conversational/respond for embeddings
# (text-embedding-3-small), by /api/transcribe (whisper-1), and by /api/tts.
# After the LLM swap, the chat LLM is the local OpenClaw bluecatfish agent, so
# OpenAI is no longer used for the tutor's reasoning, only for the three
# satellite services below until they are localized.
OPENAI_API_KEY=

# OpenClaw tutor LLM. The route is env-gated:
#  - Local dev (Mac): leave both unset. The route spawns the local openclaw CLI.
#  - Vercel production: set OPENCLAW_GATEWAY_URL to the Minisforum OpenClaw HTTP
#    bridge (exposed via cloudflared) and OPENCLAW_GATEWAY_TOKEN to the bridge
#    auth token. The route POSTs { message, agent, thinking } and expects
#    { reply } or the openclaw --json shape.
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=

# Redis slide cache. Optional — if unreachable, lessons regenerate per request.
REDIS_URL=

# Manim render service on Railway (background animation pass).
# Include https:// — the route adds it if missing, but set it properly.
MANIM_RENDER_URL=
MANIM_RENDER_TOKEN=
